# Copy this file to .env for local development.
# VITE_FILE_ENCRYPTION_KEY is OPTIONAL.
# If omitted, the app auto-generates and stores a managed local key.
# Set it only when you want a fixed key across devices/installs.
# Example generation:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
VITE_FILE_ENCRYPTION_KEY=
