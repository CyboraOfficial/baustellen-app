{
  "name": "baustellen-app",
  "private": true,
  "version": "1.0.4",
  "main": "electron/main.js",
  "homepage": ".",
  "build": {
    "appId": "com.baustellen.app",
    "productName": "BaustellenApp",
    "win": {
      "target": "nsis"
    },
    "directories": {
    "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pocketbase": "^0.26.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
