{
  "name": "baustellen-app",
  "private": true,
  "version": "1.1.2",
  "description": "App zur Verwaltung von Baustellen",
  "author": "CyboraOfficial",
  "main": "electron/main.js",
  "homepage": ".",
  "build": {
    "appId": "com.baustellen.app",
    "productName": "BaustellenApp",
    "copyright": "Copyright © 2026 CyboraOfficial",
    "publish": [
      {
        "provider": "github",
        "owner": "CyboraOfficial",
        "repo": "baustellen-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\""
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "electron-updater": "^6.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pocketbase": "^0.26.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}